
          <!-- crosshair: previews and controls stay put; only the tile grid scrolls, in whatever height is left -->
          <ScrollViewer x:Name="CrossPage" Visibility="Collapsed" Style="{StaticResource PageScroll}">
            <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
          <Grid Margin="32,26,32,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Прицел" Style="{StaticResource PageTitle}"/>
            <TextBlock Grid.Row="1" Style="{StaticResource PageNote}" Text="Выбери вариант, цвет и размер. Слева — стандартный прицел игры."/>
            <Grid x:Name="CrossView" Grid.Row="2" Height="150" Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border CornerRadius="14" ClipToBounds="True">
                <Grid>
                  <Image x:Name="SceneBefore" Stretch="UniformToFill"/>
                  <Image x:Name="BeforeImage" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor"
                         AutomationProperties.Name="Стандартный прицел"/>
                  <Border Style="{StaticResource Chip}"><TextBlock Text="Было" Foreground="White" FontSize="12"/></Border>
                </Grid>
              </Border>
              <Border Grid.Column="2" CornerRadius="14" ClipToBounds="True">
                <Grid>
                  <Image x:Name="SceneAfter" Stretch="UniformToFill"/>
                  <Image x:Name="AfterImage" Width="128" Height="128" RenderOptions.BitmapScalingMode="HighQuality"
                         RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Новый прицел">
                    <Image.RenderTransform><ScaleTransform x:Name="AfterScale"/></Image.RenderTransform>
                  </Image>
                  <Border CornerRadius="11" Background="#8C1C1C1E" BorderBrush="#33FFFFFF" BorderThickness="0.5" Padding="2"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                    <StackPanel x:Name="Scenes" Orientation="Horizontal"/>
                  </Border>
                  <Border Style="{StaticResource Chip}"><TextBlock x:Name="AfterLabel" Text="Станет" Foreground="White" FontSize="12" FontWeight="Medium"/></Border>
                </Grid>
              </Border>
            </Grid>
            <Border Grid.Row="3" CornerRadius="12" Background="{DynamicResource Group}" Margin="0,16,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="16,12">
                  <StackPanel Margin="0,0,60,0">
                    <TextBlock Text="Заменить прицел" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="CrossNote" Text="Вместо большого круглого" Style="{StaticResource RowNote}"/>
                  </StackPanel>
                  <CheckBox x:Name="CrossSwitch" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right"
                            VerticalAlignment="Center" AutomationProperties.Name="Менять прицел"/>
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <!-- soft edges instead of a hard cut through a row of tiles -->
                <ScrollViewer Grid.Row="2" Style="{StaticResource PageScroll}" MaxHeight="232">
                  <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.05"/>
                      <GradientStop Color="#FF000000" Offset="0.9"/><GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                  </ScrollViewer.OpacityMask>
                  <UniformGrid x:Name="Tiles" Columns="6" Margin="16,12,16,4" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </ScrollViewer>
                <Border Grid.Row="3" Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid x:Name="ColourControls" Grid.Row="4" Margin="16,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Цвет" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Width="52"/>
                  <StackPanel x:Name="Swatches" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Grid>
                <Border Grid.Row="5" Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid x:Name="SizeControls" Grid.Row="6" Margin="16,4">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Размер" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Width="52"/>
                  <Slider x:Name="SizeSlider" Grid.Column="1" Margin="14,0" Height="40" Style="{StaticResource SizeRange}" VerticalAlignment="Center"
                          Minimum="50" Maximum="200" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                          SmallChange="5" LargeChange="10" FocusVisualStyle="{StaticResource Focus}"
                          AutomationProperties.Name="Размер прицела в процентах" ToolTip="От 50 до 200%. Стрелки: шаг 5%."/>
                  <TextBlock x:Name="SizeValue" Grid.Column="2" Text="100%" MinWidth="40" TextAlignment="Right"
                             VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>
          </ScrollViewer>
