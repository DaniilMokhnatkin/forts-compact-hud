
          <!-- backup -->
          <StackPanel x:Name="BackupPage" Visibility="Collapsed">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <TextBlock Text="Резервная копия" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageNote}" Text="Перед первой установкой файлы игры сохраняются. Кнопка «Вернуть оригинал» кладёт их обратно."/>
            <Border CornerRadius="12" Background="{DynamicResource Group}" Margin="0,18,0,0">
              <StackPanel>
                <Grid Margin="16,12">
                  <TextBlock Text="Состояние" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="BackupState" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid Margin="16,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Где лежит" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="BackupPath" Grid.Column="1" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"
                             TextTrimming="CharacterEllipsis" Margin="24,0,0,0"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid Margin="16,12">
                  <TextBlock Text="Если игра обновилась" Style="{StaticResource RowTitle}"/>
                  <TextBlock Text="новые файлы не трогаются" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource PageNote}" Margin="4,12,0,0" FontSize="12"
                       Text="Полностью чистый интерфейс вернёт и Steam: Свойства → Установленные файлы → Проверить целостность."/>
          </StackPanel>

          <!-- working / done / error -->
          <StackPanel x:Name="WorkPage" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Margin="0,0,0,40">
            <Grid Width="76" Height="76" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="BadgeScale"/></Grid.RenderTransform>
              <Ellipse x:Name="DoneCircle" Opacity="0">
                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#34A0FF" Offset="0"/><GradientStop Color="#0A6CF0" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#0A7AFF" Opacity="0.35"/></Ellipse.Effect>
              </Ellipse>
              <!-- dash lengths are in stroke widths: the check is ~44px = ~9.8 widths -->
              <Path x:Name="DoneCheck" Data="M 24,39 L 34,49 L 53,28" Stroke="White" StrokeThickness="4.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    StrokeDashArray="11 11" StrokeDashOffset="11"/>
              <Ellipse x:Name="ErrorCircle" Fill="{StaticResource Danger}" Visibility="Collapsed"/>
              <TextBlock x:Name="ErrorMark" Text="!" Foreground="White" FontSize="36" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="WorkTitle" Text="Устанавливаю…" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            <TextBlock x:Name="WorkText" Style="{StaticResource PageNote}" TextAlignment="Center" Margin="0,8,0,0"/>
            <Grid x:Name="Bar" Height="6" Margin="0,24,0,0">
              <Border CornerRadius="3" Background="#E8E8ED"/>
              <Border x:Name="BarFill" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
          </StackPanel>
        </Grid>

        <!-- footer -->
        <Grid Grid.Row="1" Margin="32,0,24,0">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="360">
            <TextBlock x:Name="Summary" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="RestoreBtn" Style="{StaticResource Secondary}" Content="Вернуть оригинал" Margin="0,0,10,0"/>
            <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="Установить" IsDefault="True"/>
            <Button x:Name="BackBtn" Style="{StaticResource Secondary}" Content="Назад" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="DoneBtn" Style="{StaticResource Primary}" Content="Закрыть" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
