
          <!-- about the developer -->
          <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" Style="{StaticResource PageScroll}">
            <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
            <StackPanel Margin="32,26,32,24">
            <TextBlock Text="О разработчике" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageNote}" Text="Forts Setup делаю я. Установщик бесплатный и без модов."/>
            <Border CornerRadius="12" Background="{DynamicResource Group}" Margin="0,18,0,0">
              <Grid Margin="16,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="46" Height="46">
                  <Image x:Name="AuthorAvatar" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Даниил">
                    <Image.Clip><EllipseGeometry Center="23,23" RadiusX="23" RadiusY="23"/></Image.Clip>
                  </Image>
                  <Ellipse Width="46" Height="46" Stroke="#1F000000" StrokeThickness="0.5"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Даниил · Starkoff" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="Автор Forts Setup и компактного HUD Starkoff" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
                </StackPanel>
                <Button x:Name="AuthorLink" Grid.Column="2" Style="{StaticResource Link}" Content="GitHub" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <TextBlock Text="Ещё для Forts" Style="{StaticResource Section}"/>
            <Border CornerRadius="12" Background="{DynamicResource Group}">
              <StackPanel Margin="16,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Image x:Name="MatchroomIcon" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Matchroom Next"/>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Matchroom Next" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Программа для Forts: история матчей и рейтинг 1v1 по реплеям, твоя эффективность в каждом матче, аватарки и ники Steam, радар сильных игроков." Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,14,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="MatchroomDownload" Style="{StaticResource Primary}" Content="Скачать последнюю версию"/>
                  <Button x:Name="MatchroomPage" Style="{StaticResource Link}" Content="Страница на GitHub" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ProgressBar x:Name="MatchroomProgress" Height="4" Minimum="0" Maximum="100" Margin="0,12,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="MatchroomStatus" Style="{StaticResource StatusNote}"/>
              </StackPanel>
            </Border>
            <TextBlock Text="А ещё у меня есть крутой скриншотер!" Style="{StaticResource Section}"/>
            <Border CornerRadius="12" Background="{DynamicResource Group}">
              <StackPanel Margin="16,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Image x:Name="KadrIcon" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Kadr"/>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Kadr" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Очень быстрый скриншотер на Rust: запись экрана, мгновенный перевод текста на экране, блюр важных данных. Помнит 25 последних снимков и 50 скопированных текстов, вызов по Win+V." Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,14,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="KadrDownload" Style="{StaticResource Primary}" Content="Скачать Kadr"/>
                  <Button x:Name="KadrPage" Style="{StaticResource Link}" Content="Страница на GitHub" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ProgressBar x:Name="KadrProgress" Height="4" Minimum="0" Maximum="100" Margin="0,12,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="KadrStatus" Style="{StaticResource StatusNote}"/>
              </StackPanel>
            </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- backup -->
          <ScrollViewer x:Name="BackupPage" Visibility="Collapsed" Style="{StaticResource PageScroll}">
            <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
            <StackPanel Margin="32,26,32,24">
            <TextBlock Text="Резервная копия" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageNote}" Text="Перед первой установкой файлы игры сохраняются. Кнопка «Вернуть оригинал» кладёт их обратно."/>
            <Border CornerRadius="12" Background="{DynamicResource Group}" Margin="0,18,0,0">
              <StackPanel>
                <Grid Margin="16,12">
                  <TextBlock Text="Состояние" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="BackupState" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid Margin="16,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Где лежит" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="BackupPath" Grid.Column="1" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"
                             TextTrimming="CharacterEllipsis" Margin="24,0,0,0"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid Margin="16,12">
                  <TextBlock Text="Если игра обновилась" Style="{StaticResource RowTitle}"/>
                  <TextBlock Text="новые файлы не трогаются" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Footnote}"
                       Text="Полностью чистый интерфейс вернёт и Steam: Свойства → Установленные файлы → Проверить целостность."/>
            </StackPanel>
          </ScrollViewer>

          <!-- working / done / error -->
          <StackPanel x:Name="WorkPage" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Margin="0,0,0,40">
            <Grid Width="76" Height="76" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="BadgeScale"/></Grid.RenderTransform>
              <Ellipse x:Name="DoneCircle" Opacity="0">
                <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#34A0FF" Offset="0"/><GradientStop Color="#0A6CF0" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#0A7AFF" Opacity="0.35"/></Ellipse.Effect>
              </Ellipse>
              <!-- dash lengths are in stroke widths: the check is ~44px = ~9.8 widths -->
              <Path x:Name="DoneCheck" Data="M 24,39 L 34,49 L 53,28" Stroke="White" StrokeThickness="4.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    StrokeDashArray="11 11" StrokeDashOffset="11"/>
              <Ellipse x:Name="ErrorCircle" Fill="{StaticResource Danger}" Visibility="Collapsed"/>
              <TextBlock x:Name="ErrorMark" Text="!" Foreground="White" FontSize="36" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <TextBlock x:Name="WorkTitle" Text="Устанавливаю…" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            <TextBlock x:Name="WorkText" Style="{StaticResource PageNote}" TextAlignment="Center" Margin="0,8,0,0"/>
            <Grid x:Name="Bar" Height="6" Margin="0,24,0,0">
              <Border CornerRadius="3" Background="#E8E8ED"/>
              <Border x:Name="BarFill" CornerRadius="3" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
          </StackPanel>
        </Grid>

        <!-- footer; the hairline shows only while the page has more content underneath -->
        <Border x:Name="FooterRule" Grid.Row="1" Height="1" VerticalAlignment="Top" Background="{DynamicResource Separator}" Opacity="0" IsHitTestVisible="False"/>
        <Grid Grid.Row="1" Margin="32,0,24,0">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="360">
            <TextBlock x:Name="Summary" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="RestoreBtn" Style="{StaticResource Secondary}" Content="Вернуть оригинал" Margin="0,0,10,0"/>
            <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="Установить" IsDefault="True"/>
            <Button x:Name="BackBtn" Style="{StaticResource Secondary}" Content="Назад" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="DoneBtn" Style="{StaticResource Primary}" Content="Закрыть" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
