          <ScrollViewer x:Name="BackgroundPage" Visibility="Collapsed" Style="{StaticResource PageScroll}">
            <ScrollViewer.Resources>
              <Style x:Key="BackgroundPreset" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Group}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style>
              <!-- 16:9 thumbnail well shared by both image rows -->
              <Style x:Key="BackgroundThumb" TargetType="Border">
                <Setter Property="Width" Value="124"/>
                <Setter Property="Height" Value="70"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#E8E8ED"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
              </Style>
            </ScrollViewer.Resources>
            <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
            <StackPanel Margin="32,26,32,16">
            <TextBlock Text="Свой фон Forts" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Выбери картинку для главного меню. Для лобби и остальных экранов можно добавить отдельный фон без надписей." Style="{StaticResource PageNote}"/>

            <TextBlock Text="Готовые фоны" Style="{StaticResource Section}" Margin="4,16,0,8"/>
            <UniformGrid x:Name="BackgroundPresets" Rows="1" Columns="3" Margin="-4,0"/>

            <TextBlock Text="Свои изображения" Style="{StaticResource Section}" Margin="4,16,0,8"/>
            <Border CornerRadius="12" Background="{DynamicResource Group}">
              <StackPanel>
                <Grid Margin="12,8,16,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource BackgroundThumb}">
                    <Grid><TextBlock Text="Не выбрано" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Tertiary}"/><Image x:Name="MenuBackgroundPreview" Stretch="UniformToFill"/></Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Главное меню" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="MenuBackgroundName" Text="Без изменений" Style="{StaticResource RowNote}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button x:Name="ChooseMenuBackground" Content="Выбрать изображение…" Style="{StaticResource Link}" AutomationProperties.Name="Выбрать фон главного меню"/>
                      <Button x:Name="ClearMenuBackground" Content="Убрать" Style="{StaticResource Link}" Margin="14,0,0,0" AutomationProperties.Name="Убрать выбранный фон главного меню"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid Margin="12,8,16,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource BackgroundThumb}">
                    <Grid><TextBlock Text="Не выбрано" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Tertiary}"/><Image x:Name="ScreensBackgroundPreview" Stretch="UniformToFill"/></Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Лобби и другие экраны" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="ScreensBackgroundName" Text="Без изменений" Style="{StaticResource RowNote}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button x:Name="ChooseScreensBackground" Content="Выбрать изображение…" Style="{StaticResource Link}" AutomationProperties.Name="Выбрать фон остальных экранов"/>
                      <Button x:Name="ClearScreensBackground" Content="Убрать" Style="{StaticResource Link}" Margin="14,0,0,0" AutomationProperties.Name="Убрать выбранный фон остальных экранов"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
                <Grid Margin="16,11">
                  <StackPanel Margin="0,0,60,0">
                    <TextBlock Text="Оставить надпись Forts" Style="{StaticResource RowTitle}"/>
                    <TextBlock Text="Логотип добавляется только в главное меню." Style="{StaticResource RowNote}"/>
                  </StackPanel>
                  <CheckBox x:Name="BackgroundLogoSwitch" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Оставить надпись Forts"/>
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock x:Name="BackgroundStatus" Style="{StaticResource StatusNote}" Foreground="{StaticResource Danger}" Margin="4,8,4,0"/>
            <TextBlock Text="PNG, JPG или BMP · обрезка по центру до 16:9 · 1920×1080. Прозрачные области станут чёрными." Style="{StaticResource Footnote}"/>
            <TextBlock Text="Применяется к обычным темам меню, включая DLC. Сезонные темы могут показывать свой фон. После установки перезапусти Forts." Style="{StaticResource Footnote}" Margin="4,4,4,0"/>

            <Border CornerRadius="12" Background="{DynamicResource Group}" Margin="0,20,0,0">
              <Grid Margin="16,13">
                <TextBlock Text="Вернуть сохранённые фоны" Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,60,0"/>
                <CheckBox x:Name="RestoreBackgroundSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Вернуть сохранённые фоны"/>
              </Grid>
            </Border>
          </StackPanel>
          </ScrollViewer>
