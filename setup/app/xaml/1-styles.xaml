<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forts Setup" Width="1000" Height="780" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="Transparent" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1D1D1F"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#0A7AFF"/>
    <SolidColorBrush x:Key="Label" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Tertiary" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Separator" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="Group" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="Danger" Color="#E5372E"/>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <BackEase x:Key="Spring" EasingMode="EaseOut" Amplitude="0.35"/>

    <Style x:Key="Focus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="#800A7AFF" StrokeThickness="3"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- macOS switch: accent track, white knob that springs across -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="42" Height="24" Background="Transparent">
              <Border x:Name="Track" CornerRadius="12" Background="#E3E3E8"/>
              <Ellipse Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Slide"/></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.22"/></Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="18" Duration="{SPRING}" EasingFunction="{StaticResource Spring}"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="{SPRING}" EasingFunction="{StaticResource Spring}"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- sidebar item: icon square, label, trailing value -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Nav"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="Hover" CornerRadius="9" Background="#0F000000" Opacity="0"/>
              <ContentPresenter x:Name="Body" Margin="8,0,10,0" VerticalAlignment="Center" TextElement.FontWeight="Medium"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                <Setter TargetName="Body" Property="TextElement.Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
