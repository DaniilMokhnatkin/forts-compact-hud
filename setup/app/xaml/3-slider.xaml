
    <!-- macOS slider: thin track, accent fill, white knob with a soft shadow -->
    <Style x:Key="SizeRange" TargetType="Slider">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" Margin="10,0">
              <Border Height="4" CornerRadius="2" Background="#E3E3E8" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track" Height="36" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                      <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center"/></Grid>
                    </ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="22" Height="22" Cursor="Hand">
                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="White" Stroke="#14000000" StrokeThickness="0.5">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.25"/></Ellipse.Effect>
                      </Ellipse>
                    </ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
    </Style>

    <!-- grouped list row text -->
    <Style x:Key="RowTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style x:Key="RowNote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PageNote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>
    <!-- grouped-list section header, like System Settings -->
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="4,20,0,8"/>
    </Style>
    <!-- footnote under a group -->
    <Style x:Key="Footnote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="4,8,4,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <!-- status line that takes no space until it has something to say -->
    <Style x:Key="StatusNote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Style.Triggers>
        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
    </Style>
    <!-- glass chip over pictures -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Background" Value="#8C1C1C1E"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Margin" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <!-- colour swatch: filled circle, accent ring when chosen -->
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Colour"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Width="30" Height="30" Background="Transparent">
              <Ellipse x:Name="Ring" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" Opacity="0"/>
              <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="#33000000" StrokeThickness="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- scene picker over the preview: segments on dark glass -->
    <Style x:Key="SceneSeg" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Scene"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="P" CornerRadius="9" Padding="10,3" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <TextBlock x:Name="L" Text="{TemplateBinding Content}" Foreground="#CCFFFFFF" FontSize="11.5" FontWeight="Medium"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="P" Property="Background" Value="#40FFFFFF"/>
                <Setter TargetName="L" Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="P" Property="BorderBrush" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- HUD layout picker: macOS segmented control -->
    <Style x:Key="LayoutSeg" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Layout"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="P" CornerRadius="8" Padding="16,5" Background="Transparent">
              <TextBlock x:Name="L" Text="{TemplateBinding Content}" FontWeight="Medium" Foreground="{StaticResource SecondaryText}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="L" Property="Foreground" Value="{StaticResource Label}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="P" Property="Background" Value="White"/>
                <Setter TargetName="P" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="4" ShadowDepth="0.5" Direction="270" Opacity="0.18"/></Setter.Value></Setter>
                <Setter TargetName="L" Property="Foreground" Value="{StaticResource Label}"/>
                <Setter TargetName="L" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LangSeg" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Lang"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="P" CornerRadius="6" Padding="10,2" Background="Transparent">
              <TextBlock x:Name="L" Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="P" Property="Background" Value="White"/>
                <Setter TargetName="P" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Direction="270" Opacity="0.2"/></Setter.Value></Setter>
                <Setter TargetName="L" Property="Foreground" Value="{StaticResource Label}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- HUD skin chip: our pause button drawn in that skin -->
    <Style x:Key="SkinChip" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Skin"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Width="38" Height="38" Background="Transparent">
              <Border x:Name="Ring" CornerRadius="10" BorderBrush="{DynamicResource Accent}" BorderThickness="2.5" Opacity="0"/>
              <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="30" Height="30"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.35"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TahoeCombo" TargetType="ComboBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      </Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="10" Background="White" BorderBrush="#20000000" BorderThickness="1"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#6E6E73" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="13,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="#FCFCFE" BorderBrush="#24000000" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,4,6,8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.15"/></Border.Effect>
              <ScrollViewer MaxHeight="260"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TahoeField" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Label}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Label}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="B" CornerRadius="10" Background="White" BorderBrush="#26000000" BorderThickness="1">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#44000000"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.6"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HueRange" TargetType="Slider" BasedOn="{StaticResource SizeRange}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent" Margin="10,0"><Track x:Name="PART_Track" Height="36" VerticalAlignment="Center">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="22" Height="22"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="#66000000" StrokeThickness="1"><Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.25"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track></Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
