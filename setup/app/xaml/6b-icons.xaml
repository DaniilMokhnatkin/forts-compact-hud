
          <!-- icons: opacity of the extinguish / construction / repair icons -->
          <StackPanel x:Name="IconsPage" Visibility="Collapsed">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <TextBlock Text="Иконки" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageNote}" Text="Значки тушения, строительства и ремонта над фортом. Сделай их полупрозрачными, чтобы не закрывали постройки."/>
            <Border CornerRadius="14" ClipToBounds="True" Height="120" Margin="0,16,0,0">
              <Grid>
                <Image x:Name="IconScene" Stretch="UniformToFill"/>
                <StackPanel x:Name="IconPreview" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Border CornerRadius="12" Background="{StaticResource Group}" Margin="0,16,0,0">
              <StackPanel x:Name="IconRows"/>
            </Border>
            <Button x:Name="IconsReset" Style="{StaticResource Link}" Content="Вернуть всем 100%" FontSize="12"
                    HorizontalAlignment="Left" Margin="4,10,0,0"/>
          </StackPanel>
